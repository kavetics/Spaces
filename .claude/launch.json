{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--host"
      ],
      "port": 5173
    },
    {
      "name": "built",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NODE_ENV=production",
        "PORT=8788",
        "node",
        "--env-file=.env",
        "server/src/index.js"
      ],
      "port": 8788
    },
    {
      "name": "votes-test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NODE_ENV=production",
        "PORT=8789",
        "VOTES_STORE=memory",
        "node",
        "--env-file=.env",
        "server/src/index.js"
      ],
      "port": 8789
    },
    {
      "name": "share-test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NODE_ENV=production",
        "PORT=8790",
        "node",
        "--env-file=.env",
        "--env-file=.env.test",
        "server/src/index.js"
      ],
      "port": 8790
    }
  ]
}
